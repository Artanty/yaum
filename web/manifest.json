{
  "manifest_version": 3,
  "name": "YaMusic Share → YouTube Music",
  "version": "0.2.0",
  "description": "Reads the rendered track list from a Yandex Music playlist/album tab (DOM only — no Yandex API, no token, cannot WAF-403) and converts it to YouTube Music links via a mush server.",
  "minimum_chrome_version": "116",
  "permissions": ["clipboardWrite", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://music.yandex.ru/*", "*://music.yandex.kz/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "popup.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YaMusic Share → YouTube Music"
  }
}
