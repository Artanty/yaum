            "body": {
              "mode": "raw",
              "raw": "{\n  \"extensionId\": \"abcdefghijklmnop\",\n  \"userId\": 1,\n  \"entries\": [\n    { \"ts\": 1760000000000, \"level\": \"info\", \"scope\": \"scan\", \"msg\": \"debug entry from postman\" },\n    { \"ts\": 1760000001000, \"level\": \"error\", \"scope\": \"scan\", \"msg\": \"boom\", \"stack\": \"Error: boom\\n    at x\" }\n  ]\n}"
            },
            "url": { "raw": "{{PLST_back_domain}}/api/library/ext-logs", "host": ["{{PLST_back_domain}}"], "path": ["api", "library", "ext-logs"] },
            "description": "200 {ok, received, stored, dropped, capped}. entries is required (400 otherwise). userId in the body is for the extension (no header interceptor); x-user-id header wins when present. Writes one 'ext logs ingested' line into app.log — that line is the proof the upload arrived."
          }
        },
        {
          "name": "GET /api/library/ext-logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PLST_back_domain}}/api/library/ext-logs?last=100&level=error",
              "host": ["{{PLST_back_domain}}"],
              "path": ["api", "library", "ext-logs"],
              "query": [
                { "key": "last", "value": "100", "description": "1..1000, default 100" },
                { "key": "level", "value": "error", "description": "info | warn | error (omit for all)" },
                { "key": "extensionId", "value": "", "description": "filter by extension id" },
                { "key": "userId", "value": "", "description": "filter by user id" }
              ]
            },
            "description": "200 {count, totalInFile, matchedInFile, entries} from logs/ext.log (not app.log)."
