# Yandex Music access token (public playlists/albums work without it)
# get one via: node scripts/get_yandex_token.mjs
YANDEX_TOKEN=

# Optional proxy for Yandex requests (only needed if your server is outside RU
# and Yandex blocks it):
# YANDEX_PROXY=http://user:pass@host:port

# Proxy for YouTube Music requests (needed if your server cannot reach
# music.youtube.com directly, e.g. servers in Russia):
# YTM_PROXY=http://user:pass@host:port

# Storage / tuning
DB_PATH=mush.db
SEARCH_CONCURRENCY=4
MATCH_ACCEPT=0.75
MATCH_UNCERTAIN=0.55
DURATION_TOLERANCE=5

# Server
HOST=127.0.0.1
PORT=8000
